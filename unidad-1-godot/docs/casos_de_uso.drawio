<mxfile host="app.diagrams.net" type="device">
  <diagram id="casos-de-uso" name="Casos de uso (corregido)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Límite del sistema -->
        <mxCell id="sistema" value="Parchís" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1420" height="560" as="geometry" />
        </mxCell>

        <!-- Actores -->
        <mxCell id="jugador" value="Jugador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="20" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="servidor" value="Servidor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="720" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Casos de uso originales -->
        <mxCell id="cu01" value="CU01 Registrar Jugador" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu02" value="CU02 Confirmar Estado" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu03" value="CU03 Iniciar Partida" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu04" value="CU04 Lanzar Dado" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu05" value="CU05 Liberar Ficha" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu06" value="CU06 Mover Ficha" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu07" value="CU07 Capturar Ficha" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu08" value="CU08 Bloquear Camino" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu09" value="CU09 Sincronizar Tablero" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="560" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu10" value="CU10 Gestionar Abandono" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="560" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu11" value="CU11 Declarar Ganador" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="360" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Casos de uso nuevos (en azul) -->
        <mxCell id="cu12" value="CU12 Ejercer Turno del Juego" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="170" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cu13" value="CU13 Repetir Tiro" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Asociaciones del Jugador -->
        <mxCell id="a1" style="endArrow=none;html=1;" edge="1" parent="1" source="jugador" target="cu01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="endArrow=none;html=1;" edge="1" parent="1" source="jugador" target="cu02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1" source="jugador" target="cu12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" style="endArrow=none;html=1;" edge="1" parent="1" source="jugador" target="cu08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="jugador" target="cu10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1440" y="50" />
              <mxPoint x="1440" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Asociaciones del Servidor -->
        <mxCell id="s1" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="servidor" target="cu03">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s2" style="endArrow=none;html=1;" edge="1" parent="1" source="servidor" target="cu05">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" style="endArrow=none;html=1;" edge="1" parent="1" source="servidor" target="cu09">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" style="endArrow=none;html=1;" edge="1" parent="1" source="servidor" target="cu10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="servidor" target="cu11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1430" y="760" />
              <mxPoint x="1430" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- «include» -->
        <mxCell id="i1" value="«include»" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu12" target="cu04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="«include»" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu12" target="cu06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="«include»&lt;br&gt;&lt;i&gt;el dado y el cambio de turno se ven en todos los clientes&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu12" target="cu09">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="«include»&lt;br&gt;&lt;i&gt;cada movimiento actualiza la pantalla de todos los clientes&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu06" target="cu09">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- «extend» (la flecha apunta al caso base) -->
        <mxCell id="e1" value="«extend»&lt;br&gt;&lt;i&gt;solo si el dado cae exactamente en 5&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu05" target="cu04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="«extend»&lt;br&gt;&lt;i&gt;si sale 6 (máximo 3 tiros seguidos)&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu13" target="cu04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="«extend»&lt;br&gt;&lt;i&gt;solo si la ficha cae en una casilla ocupada por un rival&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu07" target="cu06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="«extend»&lt;br&gt;&lt;i&gt;opcional, como estrategia de posicionamiento&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu08" target="cu06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="«extend»&lt;br&gt;&lt;i&gt;si la 4.ª ficha entra a la meta&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu11" target="cu06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="«extend»&lt;br&gt;&lt;i&gt;si el abandono deja a un único jugador activo&lt;/i&gt;" style="endArrow=open;dashed=1;html=1;endFill=0;" edge="1" parent="1" source="cu11" target="cu10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Leyenda -->
        <mxCell id="leyenda" value="&lt;b&gt;Cambios respecto al diagrama original&lt;/b&gt;&lt;br&gt;• Nuevo CU12 Ejercer Turno del Juego (caso de esta entrega): incluye CU04, CU06 y CU09.&lt;br&gt;• Nuevo CU13 Repetir Tiro (regla del 6) extiende CU04.&lt;br&gt;• CU11 Declarar Ganador también extiende CU06 (4.ª ficha en meta).&lt;br&gt;• Jugador asociado a CU10 Gestionar Abandono.&lt;br&gt;• Las asociaciones Jugador–CU04 y Jugador–CU06 pasan a CU12." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="700" width="450" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
