; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Parchiss"
config/description="Parchís multijugador web - caso de uso Ejercer turno del juego (MVC + Observer + Fachada/Mock)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Red="*res://controllers/red.gd"
Sonidos="*res://views/fx/gestor_sonidos.gd"
Animaciones="*res://views/fx/gestor_animaciones.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fuentes/Pangolin-Regular.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
