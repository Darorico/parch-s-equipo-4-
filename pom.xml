<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Proyecto padre: un módulo por cada componente de la vista de componentes. -->
    <groupId>mx.itson.parchis</groupId>
    <artifactId>ParchisEnRed</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ParchisEnRed</name>

    <modules>
        <module>DTOs</module>
        <module>InterfacesSala</module>
        <module>SalaMock</module>
        <module>Perfil</module>
        <module>Sala</module>
        <module>FabricarSala</module>
        <module>PresentacionSala</module>
        <module>ComunicacionP2P</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>mx.itson.parchis</groupId>
                <artifactId>DTOs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mx.itson.parchis</groupId>
                <artifactId>InterfacesSala</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mx.itson.parchis</groupId>
                <artifactId>SalaMock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mx.itson.parchis</groupId>
                <artifactId>Perfil</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mx.itson.parchis</groupId>
                <artifactId>Sala</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mx.itson.parchis</groupId>
                <artifactId>FabricarSala</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mx.itson.parchis</groupId>
                <artifactId>ComunicacionP2P</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
